; =========================================================
;  AI-Hotkeys — installer
;  Installs: script, portable Python, AutoHotkey v2.
;  Checks Ollama (installs it if missing), does NOT download the model.
;
;  Built by build\build.ps1, which stages this file next to payload\, manifest.txt and the
;  generated uninstall.nsh, and runs:  makensis /INPUTCHARSET UTF8 /DVERSION=<VERSION> installer.nsi
; =========================================================

Unicode true
; The official NSIS distribution only ships x86 stubs. A 32-bit installer installs the x64
; payload fine: HKCU is not redirected and stop.ps1 uses CIM, which works across bitness.
Target x86-unicode
ManifestDPIAware true
SetCompressor /SOLID lzma
RequestExecutionLevel user

!ifndef VERSION
    !error "VERSION is not defined: build with build\build.ps1, or pass /DVERSION=x.y.z to makensis"
!endif

!define APP       "AI-Hotkeys"
!define PUBLISHER "AI-Hotkeys contributors"
!define URL       "https://github.com/Jack8090-sudo/AI-Hotkeys"
!define MODEL     "qwen3.5:9b"
!define UNINSTKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP}"
!define APPKEY    "Software\${APP}"
; v1.0.0 installed here by default (D1/D11: offer to migrate away from it)
!define LEGACY_DIR "C:\AI-Hotkeys"
; Full paths only: CreateProcess would otherwise search the installer's own folder first.
!define POWERSHELL '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File'

Name "${APP}"
OutFile "AI-Hotkeys-Setup.exe"
; D1: per-user folder whose ACL (inherited from the profile) grants only the user, SYSTEM and Administrators.
InstallDir "$LOCALAPPDATA\Programs\${APP}"
BrandingText "${APP} ${VERSION}"
ShowInstDetails show

VIProductVersion "${VERSION}.0"
VIAddVersionKey "ProductName" "${APP}"
VIAddVersionKey "FileDescription" "Installer of ${APP}"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "CompanyName" "${PUBLISHER}"
VIAddVersionKey "LegalCopyright" "© 2026 AI-Hotkeys contributors — MIT"

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"
!include "Sections.nsh"
!include "StrFunc.nsh"
${StrStr}

; Generated by build\build.ps1 from the payload: !macro AIH_UNINSTALL_PAYLOAD (C08)
!include "uninstall.nsh"

Var OldDir       ; InstallDir of the previous installation (registry), normalized
Var OldVer       ; its DisplayVersion
Var ChkDir       ; .onVerifyInstDir writability cache: last folder tested...
Var ChkOk        ; ...and its result (1 = writable)
Var NoOllama     ; 1 = /NOOLLAMA on the command line
Var Purge        ; uninstaller: 1 = /PURGE on the command line
Var DirState     ; AihDirState of $INSTDIR before this install created or changed anything

!define MUI_ICON   "payload\app\icon.ico"
!define MUI_UNICON "payload\app\icon.ico"
!define MUI_ABORTWARNING

!define MUI_WELCOMEPAGE_TITLE "Installing AI-Hotkeys"
!define MUI_WELCOMEPAGE_TEXT "AI-Hotkeys uses local Qwen with three keys:$\r$\n$\r$\n    PgUp  →  fix the selected text$\r$\n    PgDn  →  summarize$\r$\n    End    →  explain$\r$\n$\r$\nThe program, Python and AutoHotkey will be installed (portable versions, only for AI-Hotkeys). If Ollama is missing, you will be offered to install it.$\r$\n$\r$\nThe ${MODEL} model is NOT downloaded: if you do not have it yet, you will be given the command at the end."

!define MUI_DIRECTORYPAGE_TEXT_TOP "The default folder is private to your Windows account.$\r$\nThe folder must be new, empty or an existing AI-Hotkeys folder, on a local drive (not a drive root, not your profile folder itself, not inside a git repository). A folder outside your user profile is restricted to your account, SYSTEM and Administrators."

!define MUI_LICENSEPAGE_TEXT_TOP "AI-Hotkeys is free software under the MIT license."
!define MUI_LICENSEPAGE_TEXT_BOTTOM "The bundled Python, AutoHotkey, SearXNG and libraries keep their own licenses: see THIRD_PARTY_NOTICES.md and the licenses folder in the install folder."
!define MUI_LICENSEPAGE_BUTTON "$(^NextBtn)"

; Kept under NSIS's 1024-character string limit.
!define MUI_FINISHPAGE_TITLE "AI-Hotkeys is installed"
!define MUI_FINISHPAGE_TEXT_LARGE
!define MUI_FINISHPAGE_TEXT "Select some text and press PgUp (fix), PgDn (summarize) or End (explain).$\r$\n$\r$\nModel: if you do not have it yet, open the Command Prompt and run$\r$\n    ollama pull ${MODEL}$\r$\nIt is a 6.6 GB download and needs a graphics card with about 8 GB of free VRAM; with less it spills into system RAM and becomes much slower. Tray icon → Free VRAM unloads it.$\r$\n$\r$\nWeb search: End may search the web through the local SearXNG, which sends search terms taken from your selected text to public search engines. Turn it off in Settings.$\r$\n$\r$\nSettings, including the Obsidian To-Do file: right-click the ✦ tray icon → Settings, or edit config.ini in the install folder."
!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_TEXT "Launch AI-Hotkeys now"
!define MUI_FINISHPAGE_RUN_FUNCTION StartApp

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "payload\app\LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"


; ---------------------------------------------------------
; Helpers shared by the installer and the uninstaller
; ---------------------------------------------------------

; Removes trailing \ or / from the string on top of the stack (a trailing backslash before
; a closing quote would break the quoting of command-line arguments).
!macro AIH_NORM_DIR_FN prefix
Function ${prefix}AihNormDir
    Exch $0
    Push $1
    again:
        StrCpy $1 $0 1 -1
        ${If} $1 == "\"
        ${OrIf} $1 == "/"
            StrCpy $0 $0 -1
            Goto again
        ${EndIf}
    Pop $1
    Exch $0
FunctionEnd
!macroend
!insertmacro AIH_NORM_DIR_FN ""
!insertmacro AIH_NORM_DIR_FN "un."

; Closes the instances running from a folder (so files can be overwritten).
; Leaves stop.ps1's exit code in $0.
!macro StopRunning DIR
    InitPluginsDir
    File "/oname=$PLUGINSDIR\stop.ps1" "stop.ps1"
    DetailPrint "Closing AI-Hotkeys if it is running from ${DIR}…"
    nsExec::ExecToLog '${POWERSHELL} "$PLUGINSDIR\stop.ps1" -Dir "${DIR}"'
    Pop $0
!macroend


; ---------------------------------------------------------
; Install-folder rules (C09 / D1)
; ---------------------------------------------------------

; In: folder on the stack. Out: its canonical form (absolute "X:\...", no trailing \), or "!" followed
; by the reason it was rejected (SEC1). Rejected before canonicalisation: UNC and device paths
; (\\server\share, \\?\, \\.\), drive-relative paths (C: or C:foo), empty, "." and ".." segments,
; segments ending with a dot or a space (Windows silently drops those), and : * ? " < > | (an NTFS
; alternate data stream, or a wildcard). Then GetFullPathNameW gives the canonical path that every
; other check (drive root, profile, git, ACL) works on.
Function AihCanonDir
    Exch $0
    Push $1
    Push $2
    Push $3
    Push $4
    Push $5

    Push $0
    Call AihNormDir
    Pop $0

    StrCpy $1 $0 1
    StrCpy $2 $0 1 1
    ${If} $1 == "\"
    ${OrIf} $1 == "/"
        ${If} $2 == "\"
        ${OrIf} $2 == "/"
            StrCpy $0 "!Network (UNC) and device paths cannot be used: choose a folder on a local drive, such as $LOCALAPPDATA\Programs\${APP}."
        ${Else}
            StrCpy $0 "!The folder must be a full path, such as $LOCALAPPDATA\Programs\${APP}."
        ${EndIf}
        Goto done
    ${EndIf}
    StrLen $3 $0
    ${If} $2 == ":"
    ${AndIf} $3 == 2
        StrCpy $0 "!The root of a drive cannot be used: choose a folder."
        Goto done
    ${EndIf}
    StrCpy $4 $0 1 2
    StrCpy $1 0
    ${If} $2 == ":"
        ${If} $4 == "\"
        ${OrIf} $4 == "/"
            StrCpy $1 1
        ${EndIf}
    ${EndIf}
    ${If} $1 != 1
        StrCpy $0 "!The folder must be a full path, such as $LOCALAPPDATA\Programs\${APP}."
        Goto done
    ${EndIf}

    ; segments after "X:\"
    StrCpy $4 3          ; start of the current segment
    StrCpy $5 3          ; current position
    segloop:
        StrCpy $1 $0 1 $5
        ${If} $1 == "\"
        ${OrIf} $1 == "/"
        ${OrIf} $1 == ""
            IntOp $3 $5 - $4
            ${If} $3 == 0
                StrCpy $0 "!The path contains an empty folder name (two backslashes in a row)."
                Goto done
            ${EndIf}
            StrCpy $2 $0 $3 $4
            ${If} $2 == "."
            ${OrIf} $2 == ".."
                StrCpy $0 '!The path must not contain "." or ".." folders.'
                Goto done
            ${EndIf}
            StrCpy $3 $2 1 -1
            ${If} $3 == "."
            ${OrIf} $3 == " "
                StrCpy $0 "!A folder name cannot end with a dot or a space: $2"
                Goto done
            ${EndIf}
            ${If} $1 == ""
                Goto segdone
            ${EndIf}
            IntOp $4 $5 + 1
        ${ElseIf} $1 == ":"
        ${OrIf} $1 == "*"
        ${OrIf} $1 == "?"
        ${OrIf} $1 == '"'
        ${OrIf} $1 == "<"
        ${OrIf} $1 == ">"
        ${OrIf} $1 == "|"
            StrCpy $0 '!The folder name contains a character Windows does not allow there: $1'
            Goto done
        ${EndIf}
        IntOp $5 $5 + 1
        Goto segloop
    segdone:

    System::Call 'kernel32::GetFullPathNameW(w r0, i ${NSIS_MAX_STRLEN}, w .r1, p 0) i .r2'
    ${If} $2 == 0
    ${OrIf} $2 >= ${NSIS_MAX_STRLEN}
        StrCpy $0 "!The folder path is not valid or is too long."
        Goto done
    ${EndIf}
    Push $1
    Call AihNormDir
    Pop $0
    StrCpy $2 $0 1 1
    StrCpy $4 $0 1 2
    StrLen $3 $0
    ${If} $2 != ":"
    ${OrIf} $4 != "\"
    ${OrIf} $3 < 4
        StrCpy $0 "!The folder must be a full path, such as $LOCALAPPDATA\Programs\${APP}."
    ${EndIf}

    done:
    Pop $5
    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Exch $0
FunctionEnd

; In: folder on the stack. Out: what it holds (SEC1):
;   0 = does not exist, 1 = empty, 2 = only what an uninstall leaves behind (config.ini, work\,
;   prompts_user.py, prompts.local.py, prompts.py.bak-*, Uninstall.exe*),
;   3 = an AI-Hotkeys installation (.manifest, or main.ahk together with qwen_client.py),
;   4 = anything else: someone else's files.
Function AihDirState
    Exch $0
    Push $1
    Push $2
    Push $3
    Push $4

    ${IfNot} ${FileExists} "$0\*.*"
        StrCpy $3 0
        Goto done
    ${EndIf}
    ${If} ${FileExists} "$0\.manifest"
        StrCpy $3 3
        Goto done
    ${EndIf}
    ${If} ${FileExists} "$0\main.ahk"
    ${AndIf} ${FileExists} "$0\qwen_client.py"
        StrCpy $3 3
        Goto done
    ${EndIf}

    StrCpy $3 1
    ClearErrors
    FindFirst $1 $2 "$0\*"
    scan:
        ${If} ${Errors}
        ${OrIf} $2 == ""
            Goto scandone
        ${EndIf}
        ${If} $2 == "."
        ${OrIf} $2 == ".."
            Goto next
        ${EndIf}
        ${If} $2 == "config.ini"
        ${OrIf} $2 == "work"
        ${OrIf} $2 == "prompts_user.py"
        ${OrIf} $2 == "prompts.local.py"
            StrCpy $3 2
            Goto next
        ${EndIf}
        StrCpy $4 $2 15
        ${If} $4 == "prompts.py.bak-"
            StrCpy $3 2
            Goto next
        ${EndIf}
        StrCpy $4 $2 13
        ${If} $4 == "Uninstall.exe"
            StrCpy $3 2
            Goto next
        ${EndIf}
        StrCpy $3 4
        Goto scandone
        next:
        ClearErrors
        FindNext $1 $2
        Goto scan
    scandone:
    FindClose $1

    done:
    StrCpy $0 $3
    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Exch $0
FunctionEnd

; In: folder on the stack. Out: "" if it can be used, otherwise the reason, on the stack.
; Rejects (after AihCanonDir's syntax rules, on the canonical path): drive roots, the user profile
; folder itself, folders inside a git repository (.git in the folder or in any parent: the v1.0.0
; default C:\AI-Hotkeys is also the source repository), existing folders that hold someone else's
; files (SEC1: an install, an uninstall and /PURGE must never mix with them; the Browse button
; already appends \${APP}), and folders that cannot be written. Called on every keystroke by
; .onVerifyInstDir, so the write test is cached per tested folder.
Function AihCheckDir
    Exch $0
    Push $1
    Push $2
    Push $3

    StrCpy $3 ""
    Push $0
    Call AihCanonDir
    Pop $0
    StrCpy $1 $0 1
    ${If} $1 == "!"
        StrCpy $3 $0 "" 1
        Goto done
    ${EndIf}

    ${GetRoot} $0 $1
    ${If} $0 == $1
        StrCpy $3 "The root of a drive cannot be used: choose a folder."
        Goto done
    ${EndIf}

    Push $PROFILE
    Call AihNormDir
    Pop $1
    ${If} $0 == $1
        StrCpy $3 "Your user profile folder itself cannot be used: choose a new folder, such as $LOCALAPPDATA\Programs\${APP}."
        Goto done
    ${EndIf}

    StrCpy $1 $0
    gitloop:
        ${If} ${FileExists} "$1\.git"
            StrCpy $3 "$1 is a git repository (it contains .git): choose another folder."
            Goto done
        ${EndIf}
        ${GetParent} $1 $2
        ${If} $2 == ""
        ${OrIf} $2 == $1
            Goto gitdone
        ${EndIf}
        StrCpy $1 $2
        Goto gitloop
    gitdone:

    ; nearest folder that already exists
    StrCpy $1 $0
    existloop:
        ${IfNot} ${FileExists} "$1\*.*"
            ${GetParent} $1 $2
            ${If} $2 == ""
            ${OrIf} $2 == $1
                StrCpy $3 "The drive of this folder does not exist."
                Goto done
            ${EndIf}
            StrCpy $1 $2
            Goto existloop
        ${EndIf}

    ${If} $1 == $0
        Push $0
        Call AihDirState
        Pop $2
        ${If} $2 == 4
            StrCpy $3 "$0 already contains other files. Choose an empty or new folder, such as $0\${APP}."
            Goto done
        ${EndIf}
    ${EndIf}

    ${If} $1 != $ChkDir
        StrCpy $ChkDir $1
        StrCpy $ChkOk 0
        ClearErrors
        ${If} $1 == $0
            ; the folder exists: can we create files in it?
            FileOpen $2 "$1\aih-write-test.tmp" w
            ${IfNot} ${Errors}
                FileClose $2
                Delete "$1\aih-write-test.tmp"
                StrCpy $ChkOk 1
            ${EndIf}
        ${Else}
            ; it does not exist yet: can we create a folder where it will be?
            CreateDirectory "$1\aih-write-test.tmp"
            ${IfNot} ${Errors}
                RMDir "$1\aih-write-test.tmp"
                StrCpy $ChkOk 1
            ${EndIf}
        ${EndIf}
    ${EndIf}
    ${If} $ChkOk != 1
        StrCpy $3 "$1 is not writable with your account: choose another folder."
    ${EndIf}

    done:
    StrCpy $0 $3
    Pop $3
    Pop $2
    Pop $1
    Exch $0
FunctionEnd

Function .onVerifyInstDir
    Push $0
    Push $INSTDIR
    Call AihCheckDir
    Pop $0
    ${If} $0 != ""
        Pop $0
        Abort
    ${EndIf}
    Pop $0
FunctionEnd

; In: base folder, then (top) folder. Out: 1 if folder is base or inside it, else 0.
Function AihIsUnder
    Exch $0      ; folder
    Exch
    Exch $1      ; base
    Push $2
    Push $3
    StrCpy $2 "0"
    ${If} $1 != ""
        ${If} $0 == $1
            StrCpy $2 "1"
        ${Else}
            StrLen $3 "$1\"
            StrCpy $3 $0 $3
            ${If} $3 == "$1\"          ; StrCmp is case-insensitive
                StrCpy $2 "1"
            ${EndIf}
        ${EndIf}
    ${EndIf}
    StrCpy $0 $2
    Pop $3
    Pop $2
    Pop $1
    Exch $0
FunctionEnd

; A folder outside the user profile inherits the parent's ACL (for example C:\ grants
; Authenticated Users the right to create and modify). Everything in it runs as the user at
; login, so it gets an explicit, non-inherited ACL: the user, SYSTEM and Administrators only.
Function AihSecureDir
    Push $LOCALAPPDATA
    Push $INSTDIR
    Call AihIsUnder
    Pop $0
    ${If} $0 == 1
        Return
    ${EndIf}
    Push $PROFILE
    Push $INSTDIR
    Call AihIsUnder
    Pop $0
    ${If} $0 == 1
        Return
    ${EndIf}

    DetailPrint "Restricting $INSTDIR to your account, SYSTEM and Administrators…"
    ; current user's SID: whoami prints  "DOMAIN\user","S-1-5-21-…"
    nsExec::ExecToStack '"$SYSDIR\whoami.exe" /user /fo csv /nh'
    Pop $0
    Pop $1
    ${StrStr} $2 $1 '"S-1-'
    StrCpy $2 $2 "" 1
    StrCpy $3 0
    sidloop:
        StrCpy $4 $2 1 $3
        ${If} $4 != '"'
        ${AndIf} $4 != ""
            IntOp $3 $3 + 1
            Goto sidloop
        ${EndIf}
    StrCpy $2 $2 $3
    StrCpy $4 $2 4
    ${If} $0 != 0
    ${OrIf} $4 != "S-1-"
        MessageBox MB_OK|MB_ICONSTOP "Could not determine your Windows account (whoami: $0), so the permissions of$\r$\n$INSTDIR$\r$\ncannot be restricted. Installation stopped: choose a folder inside your user profile." /SD IDOK
        SetErrorLevel 2
        Abort
    ${EndIf}

    ; S-1-5-18 = SYSTEM, S-1-5-32-544 = Administrators. /inheritance:r drops the inherited ACEs.
    nsExec::ExecToLog '"$SYSDIR\icacls.exe" "$INSTDIR" /inheritance:r /grant:r "*$2:(OI)(CI)F" "*S-1-5-18:(OI)(CI)F" "*S-1-5-32-544:(OI)(CI)F" /C /Q'
    Pop $0
    ${If} $0 == 0
        ; explicit grants for Everyone, Authenticated Users and Users. Recursively (/T) only on a
        ; folder this installer created, or one that held nothing but what an uninstall leaves
        ; behind (SEC1); an existing installation gets it on the folder itself only, so no ACL of
        ; anything that may not be ours is ever rewritten.
        ${If} $DirState <= 2
            nsExec::ExecToLog '"$SYSDIR\icacls.exe" "$INSTDIR" /remove:g "*S-1-1-0" "*S-1-5-11" "*S-1-5-32-545" /T /C /Q'
        ${Else}
            nsExec::ExecToLog '"$SYSDIR\icacls.exe" "$INSTDIR" /remove:g "*S-1-1-0" "*S-1-5-11" "*S-1-5-32-545" /C /Q'
        ${EndIf}
        Pop $0
    ${EndIf}
    ${If} $0 != 0
        MessageBox MB_OK|MB_ICONSTOP "Could not restrict the permissions of$\r$\n$INSTDIR$\r$\n(icacls: $0). Installation stopped: choose a folder inside your user profile." /SD IDOK
        SetErrorLevel 2
        Abort
    ${EndIf}
FunctionEnd


; ---------------------------------------------------------
; Previous installations (D11)
; ---------------------------------------------------------

; Previous installation's manifest on the stack: its own .manifest, or the hard-coded v1.0.0 one.
Function AihOldManifest
    ${If} ${FileExists} "$OldDir\.manifest"
        Push "$OldDir\.manifest"
    ${Else}
        Push "$PLUGINSDIR\legacy-1.0.0.manifest"
    ${EndIf}
FunctionEnd

; '-OldVersion "x"' for manifest.ps1, or "" when the registry value is missing or unsafe to quote.
Function AihOldVersionArg
    Push $0
    StrCpy $0 ""
    ${If} $OldVer != ""
        ${StrStr} $0 $OldVer '"'
        ${If} $0 == ""
            StrCpy $0 '-OldVersion "$OldVer"'
        ${Else}
            StrCpy $0 ""
        ${EndIf}
    ${EndIf}
    Exch $0
FunctionEnd

; Copies config.ini from the old folder, unless the new folder already has one (I13).
Function AihCopyOldConfig
    ${If} ${FileExists} "$OldDir\config.ini"
    ${AndIfNot} ${FileExists} "$INSTDIR\config.ini"
        ClearErrors
        CopyFiles /SILENT "$OldDir\config.ini" "$INSTDIR\config.ini"
        ${If} ${Errors}
            DetailPrint "Could not copy $OldDir\config.ini: the default configuration will be used."
        ${Else}
            DetailPrint "Copied your configuration from $OldDir\config.ini"
        ${EndIf}
    ${EndIf}
FunctionEnd

; The registry points to an installation in another folder. With consent: stop it, copy its
; config.ini, disable its uninstaller (it would delete this installation's registry keys and
; shortcuts) and remove its shortcuts. Its folder is never deleted. Silent mode: config only.
Function AihMigrate
    ${If} ${Silent}
        Call AihCopyOldConfig
        DetailPrint "Silent install: only config.ini was taken from $OldDir; that installation was not changed."
        Return
    ${EndIf}

    MessageBox MB_YESNO|MB_ICONQUESTION "An existing AI-Hotkeys installation was found in:$\r$\n    $OldDir$\r$\n$\r$\nMove it to the new folder? This will:$\r$\n  • close the old copy if it is running$\r$\n  • copy its config.ini (your settings)$\r$\n  • disable its uninstaller (renamed to Uninstall.exe.disabled-by-${VERSION})$\r$\n  • remove its Start menu, Startup and Desktop shortcuts$\r$\n$\r$\nThe old folder itself is NOT deleted.$\r$\n$\r$\nChoose No to install without touching the old copy." IDYES migrate
    DetailPrint "Migration declined: $OldDir was left unchanged."
    Return

    migrate:
    !insertmacro StopRunning "$OldDir"
    ${If} $0 != 0
        DetailPrint "Warning: some processes of the old installation could not be closed ($0)."
    ${EndIf}

    Call AihCopyOldConfig

    ; D4: a customized prompts.py of the old copy is kept as prompts.py.bak-<oldver> in the new folder
    Call AihOldManifest
    Pop $1
    Call AihOldVersionArg
    Pop $2
    nsExec::ExecToLog '${POWERSHELL} "$PLUGINSDIR\manifest.ps1" -Action BackupPrompts -Dir "$OldDir" -Old "$1" -New "$PLUGINSDIR\new.manifest" -Dest "$INSTDIR" $2'
    Pop $0

    ${If} ${FileExists} "$OldDir\Uninstall.exe"
        Delete "$OldDir\Uninstall.exe.disabled-by-${VERSION}"
        ClearErrors
        Rename "$OldDir\Uninstall.exe" "$OldDir\Uninstall.exe.disabled-by-${VERSION}"
        ${If} ${Errors}
            MessageBox MB_OK|MB_ICONEXCLAMATION "Could not rename$\r$\n$OldDir\Uninstall.exe$\r$\nDo not run it: it would remove the shortcuts and registry entries of the new installation." /SD IDOK
        ${Else}
            DetailPrint "Old uninstaller disabled: $OldDir\Uninstall.exe.disabled-by-${VERSION}"
        ${EndIf}
    ${EndIf}

    ; v1.0.0 shortcut names (Italian included) are listed in the legacy manifest; only the ones
    ; that point into the old folder are removed. Later versions use the same file names.
    nsExec::ExecToLog '${POWERSHELL} "$PLUGINSDIR\manifest.ps1" -Action Shortcuts -Dir "$OldDir" -Old "$PLUGINSDIR\legacy-1.0.0.manifest"'
    Pop $0

    ${If} ${FileExists} "$OldDir\.git"
        MessageBox MB_OK|MB_ICONINFORMATION "Migration done. The old folder$\r$\n    $OldDir$\r$\nwas left in place. It contains a git repository (.git), so delete it only if you no longer need that repository." /SD IDOK
    ${Else}
        MessageBox MB_OK|MB_ICONINFORMATION "Migration done. The old folder$\r$\n    $OldDir$\r$\nwas left in place: once AI-Hotkeys works from the new folder, you can delete it." /SD IDOK
    ${EndIf}
FunctionEnd


; =========================================================
; SECTIONS
; =========================================================

Section "AI-Hotkeys (required)" SecMain
    SectionIn RO

    ; .onVerifyInstDir does not run for silent installs with /D=
    Push $INSTDIR
    Call AihNormDir
    Pop $INSTDIR
    Push $INSTDIR
    Call AihCheckDir
    Pop $0
    ${If} $0 != ""
        MessageBox MB_OK|MB_ICONSTOP "Cannot install to$\r$\n$INSTDIR$\r$\n$\r$\n$0" /SD IDOK
        SetErrorLevel 2
        Abort
    ${EndIf}
    ; From here on, the canonical form (SEC1): what the checks above approved
    Push $INSTDIR
    Call AihCanonDir
    Pop $INSTDIR
    Push $INSTDIR
    Call AihDirState
    Pop $DirState

    InitPluginsDir
    File "/oname=$PLUGINSDIR\manifest.ps1" "manifest.ps1"
    File "/oname=$PLUGINSDIR\legacy-1.0.0.manifest" "legacy-1.0.0.manifest"
    File "/oname=$PLUGINSDIR\new.manifest" "manifest.txt"

    CreateDirectory "$INSTDIR"
    Call AihSecureDir

    ${If} $OldDir != ""
    ${AndIf} $OldDir != $INSTDIR
    ${AndIf} ${FileExists} "$OldDir\main.ahk"
        Call AihMigrate
    ${EndIf}

    stop_again:
    !insertmacro StopRunning "$INSTDIR"
    ${If} $0 == 1
        MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "AI-Hotkeys is still running from$\r$\n$INSTDIR$\r$\nand could not be closed. Close it (tray icon → Exit), then choose Retry." /SD IDCANCEL IDRETRY stop_again
        SetErrorLevel 2
        Abort
    ${ElseIf} $0 != 0
        DetailPrint "Warning: could not check for running AI-Hotkeys processes (stop.ps1: $0)."
    ${EndIf}

    ; Upgrade (C30): back up a customized prompts.py (D4), remove the files of the previous version
    ; that this one no longer ships, and purge __pycache__. The previous version is described by
    ; $INSTDIR\.manifest (1.1.0 and later) or, for an in-place v1.0.0 upgrade, by the legacy
    ; manifest (config.esempio.ini, the old python\ layout, …; its Italian shortcuts too).
    ${If} ${FileExists} "$INSTDIR\main.ahk"
        StrCpy $3 ""
        StrCpy $0 0
        ${If} $OldDir == $INSTDIR
            Call AihOldVersionArg
            Pop $3
        ${EndIf}
        ${If} ${FileExists} "$INSTDIR\.manifest"
            DetailPrint "Upgrading: removing files the previous version no longer needs…"
            nsExec::ExecToLog '${POWERSHELL} "$PLUGINSDIR\manifest.ps1" -Action Upgrade -Dir "$INSTDIR" -Old "$INSTDIR\.manifest" -New "$PLUGINSDIR\new.manifest" $3'
            Pop $0
        ${Else}
            StrCpy $1 0
            ${If} ${FileExists} "$INSTDIR\config.esempio.ini"
                StrCpy $1 1
            ${EndIf}
            ${If} $OldDir == $INSTDIR
            ${AndIf} $OldVer == "1.0.0"
                StrCpy $1 1
            ${EndIf}
            ${If} $1 == 1
                DetailPrint "Upgrading AI-Hotkeys 1.0.0: removing obsolete files…"
                nsExec::ExecToLog '${POWERSHELL} "$PLUGINSDIR\manifest.ps1" -Action Upgrade -Dir "$INSTDIR" -Old "$PLUGINSDIR\legacy-1.0.0.manifest" -New "$PLUGINSDIR\new.manifest" -OldVersion 1.0.0'
                Pop $0
                nsExec::ExecToLog '${POWERSHELL} "$PLUGINSDIR\manifest.ps1" -Action Shortcuts -Dir "$INSTDIR" -Old "$PLUGINSDIR\legacy-1.0.0.manifest"'
                Pop $0
            ${EndIf}
        ${EndIf}
        ${If} $0 != 0
            DetailPrint "Warning: the upgrade cleanup reported a problem (manifest.ps1: $0); see the lines above."
        ${EndIf}
    ${EndIf}

    SetOutPath "$INSTDIR"
    SetOverwrite on
    File /r "payload\app\*.*"

    ; config.ini: do not overwrite the existing configuration (I13)
    SetOverwrite off
    File "payload\config.ini"
    SetOverwrite on

    SetOutPath "$INSTDIR\python"
    File /r "payload\python\*.*"

    SetOutPath "$INSTDIR\ahk"
    File /r "payload\ahk\*.*"

    SetOutPath "$INSTDIR"
    CreateDirectory "$INSTDIR\work"

    ; The manifest of what is now installed: the next upgrade removes what this one shipped and
    ; the next one does not (C30), and it holds prompts.py's shipped hash (D4).
    ClearErrors
    CopyFiles /SILENT "$PLUGINSDIR\new.manifest" "$INSTDIR\.manifest"
    ${If} ${Errors}
        DetailPrint "Warning: could not write $INSTDIR\.manifest"
    ${EndIf}

    ; Start Menu
    CreateDirectory "$SMPROGRAMS\${APP}"
    CreateShortCut "$SMPROGRAMS\${APP}\AI-Hotkeys.lnk" "$INSTDIR\ahk\AutoHotkey64.exe" '"$INSTDIR\main.ahk"' "$INSTDIR\icon.ico"
    CreateShortCut "$SMPROGRAMS\${APP}\Configuration.lnk" "$WINDIR\notepad.exe" '"$INSTDIR\config.ini"'
    CreateShortCut "$SMPROGRAMS\${APP}\Edit prompts.lnk" "$WINDIR\notepad.exe" '"$INSTDIR\prompts.py"'
    CreateShortCut "$SMPROGRAMS\${APP}\Uninstall.lnk" "$INSTDIR\Uninstall.exe"

    ; Uninstallation
    WriteUninstaller "$INSTDIR\Uninstall.exe"
    WriteRegStr HKCU "${APPKEY}" "InstallDir" "$INSTDIR"
    WriteRegStr HKCU "${UNINSTKEY}" "DisplayName" "${APP}"
    WriteRegStr HKCU "${UNINSTKEY}" "DisplayVersion" "${VERSION}"
    WriteRegStr HKCU "${UNINSTKEY}" "Publisher" "${PUBLISHER}"
    WriteRegStr HKCU "${UNINSTKEY}" "DisplayIcon" "$INSTDIR\icon.ico"
    WriteRegStr HKCU "${UNINSTKEY}" "InstallLocation" "$INSTDIR"
    WriteRegStr HKCU "${UNINSTKEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
    WriteRegStr HKCU "${UNINSTKEY}" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
    WriteRegStr HKCU "${UNINSTKEY}" "URLInfoAbout" "${URL}"
    WriteRegStr HKCU "${UNINSTKEY}" "HelpLink" "${URL}"
    WriteRegDWORD HKCU "${UNINSTKEY}" "NoModify" 1
    WriteRegDWORD HKCU "${UNINSTKEY}" "NoRepair" 1
    ; EstimatedSize: KB actually used by the install folder
    ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
    IntFmt $0 "0x%08X" $0
    WriteRegDWORD HKCU "${UNINSTKEY}" "EstimatedSize" "$0"
SectionEnd


Section "Start with Windows" SecStartup
    CreateShortCut "$SMSTARTUP\AI-Hotkeys.lnk" "$INSTDIR\ahk\AutoHotkey64.exe" '"$INSTDIR\main.ahk"' "$INSTDIR\icon.ico"
SectionEnd


Section /o "Desktop shortcut" SecDesktop
    CreateShortCut "$DESKTOP\AI-Hotkeys.lnk" "$INSTDIR\ahk\AutoHotkey64.exe" '"$INSTDIR\main.ahk"' "$INSTDIR\icon.ico"
SectionEnd


; C31/C44. Silent installs never open a browser and never run winget (the question defaults to
; "skip"). /NOOLLAMA unselects this section.
Section "Check Ollama (install if missing)" SecOllama
    StrCmp $NoOllama 1 0 find_ollama
    DetailPrint "/NOOLLAMA: Ollama check skipped."
    Goto done

    find_ollama:
    Call FindOllama
    Pop $1
    StrCmp $1 "" 0 check_model

    ${If} ${Silent}
        DetailPrint "Ollama was not found. Install it from https://ollama.com/download, then run: ollama pull ${MODEL}"
        Goto done
    ${EndIf}

    IfFileExists "$LOCALAPPDATA\Microsoft\WindowsApps\winget.exe" 0 no_winget
    MessageBox MB_YESNOCANCEL|MB_ICONQUESTION "Ollama is not installed.$\r$\n$\r$\nInstall it now with winget? It is about a 1 GB download.$\r$\nInstalling this way accepts the Ollama/winget source and package terms (winget runs with --accept-source-agreements --accept-package-agreements).$\r$\n$\r$\nYes: install with winget$\r$\nNo: open the Ollama download page instead$\r$\nCancel: skip, install Ollama later" /SD IDCANCEL IDYES run_winget IDNO ollama_page
    DetailPrint "Ollama installation skipped."
    Goto done

    no_winget:
    MessageBox MB_YESNO|MB_ICONQUESTION "Ollama is not installed, and winget is not available on this PC to install it automatically.$\r$\n$\r$\nOpen the Ollama download page?" /SD IDNO IDYES ollama_page
    DetailPrint "Ollama is not installed: get it from https://ollama.com/download"
    Goto done

    run_winget:
    DetailPrint "Installing Ollama with winget (may take a few minutes)…"
    nsExec::ExecToLog '"$LOCALAPPDATA\Microsoft\WindowsApps\winget.exe" install --id Ollama.Ollama -e --source winget --silent --accept-source-agreements --accept-package-agreements'
    Pop $0
    StrCmp $0 0 winget_ok
    DetailPrint "winget failed (exit code $0)."
    MessageBox MB_OK|MB_ICONEXCLAMATION "winget could not install Ollama (exit code $0).$\r$\nThe download page will open: install Ollama from there, then run  ollama pull ${MODEL}" /SD IDOK
    Goto ollama_page

    winget_ok:
    Call FindOllama
    Pop $1
    StrCmp $1 "" 0 installed
    MessageBox MB_OK|MB_ICONEXCLAMATION "winget finished, but ollama.exe was not found.$\r$\nThe download page will open: install Ollama from there, then run  ollama pull ${MODEL}" /SD IDOK
    Goto ollama_page

    installed:
    DetailPrint "Ollama installed."
    Goto check_model

    ollama_page:
    ; reached only from interactive questions (silent mode exits above)
    ExecShell "open" "https://ollama.com/download"
    Goto done

    check_model:
    DetailPrint "Ollama found: $1"
    ; the model configured in config.ini (the default unless the user changed it)
    ReadINIStr $2 "$INSTDIR\config.ini" "qwen" "model"
    ${StrStr} $3 $2 '"'
    ${If} $2 == ""
    ${OrIf} $3 != ""
        StrCpy $2 "${MODEL}"
    ${EndIf}
    File "/oname=$PLUGINSDIR\ollama-check.ps1" "ollama-check.ps1"
    nsExec::ExecToLog '${POWERSHELL} "$PLUGINSDIR\ollama-check.ps1" -Model "$2"'
    Pop $0
    ${If} $0 == 0
        DetailPrint "Model $2 found."
    ${ElseIf} $0 == 10
        MessageBox MB_OK|MB_ICONINFORMATION "Ollama is running, but the $2 model is not downloaded yet.$\r$\n$\r$\nTo download it, open the Command Prompt and run:$\r$\n$\r$\n    ollama pull $2" /SD IDOK
    ${ElseIf} $0 == 11
        MessageBox MB_OK|MB_ICONINFORMATION "Ollama is installed, but its server is not running, so the model could not be checked, and no downloaded copy of $2 was found on disk.$\r$\n$\r$\nStart Ollama from the Start menu. If the model is missing, open the Command Prompt and run:$\r$\n$\r$\n    ollama pull $2" /SD IDOK
    ${Else}
        DetailPrint "Could not check the model (ollama-check.ps1: $0). If it is missing, run: ollama pull $2"
    ${EndIf}

    done:
SectionEnd


LangString DESC_Main    ${LANG_ENGLISH} "Script, prompts, results page, portable Python and AutoHotkey."
LangString DESC_Startup ${LANG_ENGLISH} "Enables the PgUp / PgDn / End keys automatically when the PC starts."
LangString DESC_Desktop ${LANG_ENGLISH} "Desktop icon to launch AI-Hotkeys."
LangString DESC_Ollama  ${LANG_ENGLISH} "Checks that Ollama is installed and that the ${MODEL} model is present (the model is not downloaded)."

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
    !insertmacro MUI_DESCRIPTION_TEXT ${SecMain}    $(DESC_Main)
    !insertmacro MUI_DESCRIPTION_TEXT ${SecStartup} $(DESC_Startup)
    !insertmacro MUI_DESCRIPTION_TEXT ${SecDesktop} $(DESC_Desktop)
    !insertmacro MUI_DESCRIPTION_TEXT ${SecOllama}  $(DESC_Ollama)
!insertmacro MUI_FUNCTION_DESCRIPTION_END


; =========================================================
; FUNCTIONS
; =========================================================

; .onInit runs after the sections are declared, so ${SecOllama} exists here.
Function .onInit
    ReadRegStr $OldDir HKCU "${APPKEY}" "InstallDir"
    ReadRegStr $OldVer HKCU "${UNINSTKEY}" "DisplayVersion"
    Push $OldDir
    Call AihNormDir
    Pop $OldDir

    ; A later install in a custom folder is upgraded in place, by default. The v1.0.0 default
    ; C:\AI-Hotkeys, or a folder that no longer passes the rules, gets the new default folder
    ; instead and the migration is offered. /D=<folder> always wins.
    ${If} $OldDir != ""
    ${AndIf} $INSTDIR == "$LOCALAPPDATA\Programs\${APP}"
    ${AndIf} $OldDir != "${LEGACY_DIR}"
        Push $OldDir
        Call AihCheckDir
        Pop $0
        ${If} $0 == ""
            StrCpy $INSTDIR $OldDir
        ${EndIf}
    ${EndIf}

    ; /NOOLLAMA: no Ollama check, no winget, no browser (CI and unattended installs)
    StrCpy $NoOllama 0
    ${GetParameters} $R0
    ClearErrors
    ${GetOptions} $R0 "/NOOLLAMA" $R1
    ${IfNot} ${Errors}
        StrCpy $NoOllama 1
        !insertmacro UnselectSection ${SecOllama}
    ${EndIf}
FunctionEnd

; Returns the ollama.exe path on the stack, or "" (C44: known locations first; `where` runs with
; $SYSDIR as the working directory, so an ollama.exe next to the installer is never picked up).
Function FindOllama
    ${If} ${FileExists} "$LOCALAPPDATA\Programs\Ollama\ollama.exe"
        Push "$LOCALAPPDATA\Programs\Ollama\ollama.exe"
        Return
    ${EndIf}
    ${If} ${FileExists} "$PROGRAMFILES64\Ollama\ollama.exe"
        Push "$PROGRAMFILES64\Ollama\ollama.exe"
        Return
    ${EndIf}
    ${If} ${FileExists} "$PROGRAMFILES\Ollama\ollama.exe"
        Push "$PROGRAMFILES\Ollama\ollama.exe"
        Return
    ${EndIf}
    Push $OUTDIR
    SetOutPath "$SYSDIR"
    nsExec::ExecToStack '"$SYSDIR\where.exe" ollama.exe'
    Pop $0
    Pop $R0
    Pop $R3
    ${If} $R3 != ""
        SetOutPath $R3
    ${EndIf}
    ${If} $0 == 0
        ; first line of the output
        StrCpy $R1 0
        loop:
            StrCpy $R2 $R0 1 $R1
            ${If} $R2 == "$\r"
            ${OrIf} $R2 == "$\n"
            ${OrIf} $R2 == ""
                StrCpy $R0 $R0 $R1
                Push $R0
                Return
            ${EndIf}
            IntOp $R1 $R1 + 1
            Goto loop
    ${EndIf}
    Push ""
FunctionEnd

Function StartApp
    Exec '"$INSTDIR\ahk\AutoHotkey64.exe" "$INSTDIR\main.ahk"'
FunctionEnd


; =========================================================
; UNINSTALLATION
; =========================================================

; /PURGE also deletes config.ini and work\ without asking. Without it, a silent uninstall keeps them.
Function un.onInit
    StrCpy $Purge 0
    ${GetParameters} $R0
    ClearErrors
    ${GetOptions} $R0 "/PURGE" $R1
    ${IfNot} ${Errors}
        StrCpy $Purge 1
    ${EndIf}
FunctionEnd

; Deletes $INSTDIR\work recursively, unless it is a junction or symbolic link (SEC1): then only the
; link is removed and whatever it points to is left alone.
!macro AihRemoveWork
    System::Call 'kernel32::GetFileAttributesW(w "$INSTDIR\work") i .r0'
    ${If} $0 != -1
        IntOp $1 $0 & 0x400
        ${If} $1 != 0
            DetailPrint "$INSTDIR\work is a link (junction or symbolic link): only the link is removed."
            RMDir "$INSTDIR\work"
        ${Else}
            RMDir /r "$INSTDIR\work"
        ${EndIf}
    ${EndIf}
!macroend

Section "Uninstall"
    stop_again:
    !insertmacro StopRunning "$INSTDIR"
    ${If} $0 == 1
        MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "AI-Hotkeys is still running and could not be closed. Close it (tray icon → Exit), then choose Retry." /SD IDCANCEL IDRETRY stop_again
        SetErrorLevel 2
        Abort
    ${ElseIf} $0 != 0
        DetailPrint "Warning: could not check for running AI-Hotkeys processes (stop.ps1: $0)."
    ${EndIf}

    ; Shortcuts and registry entries belong to the registered installation only: an uninstaller
    ; left in another folder must not remove them.
    ReadRegStr $1 HKCU "${APPKEY}" "InstallDir"
    Push $1
    Call un.AihNormDir
    Pop $1
    StrCpy $2 0
    ${If} $1 == ""
    ${OrIf} $1 == $INSTDIR
        StrCpy $2 1
        Delete "$SMSTARTUP\AI-Hotkeys.lnk"
        Delete "$DESKTOP\AI-Hotkeys.lnk"
        Delete "$SMPROGRAMS\${APP}\AI-Hotkeys.lnk"
        Delete "$SMPROGRAMS\${APP}\Configuration.lnk"
        Delete "$SMPROGRAMS\${APP}\Edit prompts.lnk"
        Delete "$SMPROGRAMS\${APP}\Uninstall.lnk"
        RMDir "$SMPROGRAMS\${APP}"
    ${Else}
        DetailPrint "$INSTDIR is not the registered installation ($1): shortcuts and registry entries are kept."
    ${EndIf}

    ; C08: exactly the files of this build's payload (generated list), their __pycache__ folders,
    ; then the folders left empty. config.ini, work\, prompts_user.py and prompts.py.bak-* are
    ; not in the list.
    !insertmacro AIH_UNINSTALL_PAYLOAD
    Delete "$INSTDIR\.manifest"
    Delete "$INSTDIR\Uninstall.exe"

    ${If} $Purge == 1
        Delete "$INSTDIR\config.ini"
        !insertmacro AihRemoveWork
    ${Else}
        MessageBox MB_YESNO|MB_ICONQUESTION "Do you also want to delete the configuration (config.ini) and temporary files (work folder)?$\r$\n$\r$\nYour own prompts (prompts_user.py) and saved copies (prompts.py.bak-*) are kept either way." /SD IDNO IDNO keep_data
            Delete "$INSTDIR\config.ini"
            !insertmacro AihRemoveWork
        keep_data:
    ${EndIf}

    RMDir "$INSTDIR"

    ${If} $2 == 1
        DeleteRegKey HKCU "${UNINSTKEY}"
        DeleteRegKey HKCU "${APPKEY}"
    ${EndIf}
SectionEnd
